#pragma code_page(65001)
#include <windows.h>
#include "BuiltinResource.h"
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDD_BUILTIN_COUNTDOWN DIALOGEX 0,0,270,148
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dual Countdown Settings"
FONT 9,"Segoe UI"
BEGIN
    LTEXT "Name (max 8 chars)",-1,12,12,94,12
    LTEXT "Date (YYYY-MM-DD)",-1,118,12,140,12
    EDITTEXT IDC_COUNTDOWN_NAME1,12,30,94,16,ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_COUNTDOWN_DATE1,118,30,140,16,ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_COUNTDOWN_NAME2,12,56,94,16,ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_COUNTDOWN_DATE2,118,56,140,16,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Displays two countdown dates, e.g. Exam 12d / Trip 34d",-1,12,84,246,12
    LTEXT "Calculated by local calendar days; 0d for today, negative if past.",-1,12,100,246,12
    DEFPUSHBUTTON "OK",IDOK,150,124,50,16
    PUSHBUTTON "Cancel",IDCANCEL,208,124,50,16
END
